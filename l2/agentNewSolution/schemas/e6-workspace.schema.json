{
  "$id": "https://collab.codes/agentNewSolution/e6-workspace/2026-08-03-ns-e6-workspace-v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "title",
    "actors",
    "kind",
    "entity"
  ],
  "$defs": {
    "bffField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "from": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "item": {
          "type": "object",
          "description": "ONLY for an array field: the columns of each element. Its columns are leaves \u2014 never nest a further \"item\".",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/bffItemField"
              }
            }
          }
        }
      }
    },
    "bffItemField": {
      "type": "object",
      "description": "One COLUMN of the item: a leaf. The projection is two levels deep and stops here.",
      "additionalProperties": false,
      "required": [
        "name",
        "from"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "from": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$",
      "maxLength": 60
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "workflow",
        "operation",
        "entityManagement",
        "landing"
      ]
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 5
    },
    "bffCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bffId",
          "kind",
          "uses"
        ],
        "properties": {
          "bffId": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "enum": [
              "query",
              "command"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operationId"
              ],
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "input": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "from": {
                  "type": "string",
                  "minLength": 3
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "userDecision",
                    "selection",
                    "pageInput",
                    "actorSession",
                    "derived",
                    "actorDirectory"
                  ],
                  "description": "Where the value comes from. actorDirectory = a PERSON chosen from the platform directory of an actor role; sourceRef is that actorId."
                },
                "sourceRef": {
                  "type": "string"
                }
              }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fields"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "object",
                  "list",
                  "paginated"
                ]
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/bffField"
                }
              }
            }
          },
          "usage": {
            "type": "string",
            "description": "STAMPED BY CODE at finalize, never declared: a query that exists to feed an input of another entity (a picker), not to be browsed.",
            "enum": [
              "picker"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionId",
          "intent",
          "organisms"
        ],
        "properties": {
          "sectionId": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 60
          },
          "intent": {
            "type": "string",
            "minLength": 3
          },
          "organisms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "operationId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "primarySurface",
                    "filterControl",
                    "contextualAction",
                    "detailPanel",
                    "batchAction",
                    "navigationEntry",
                    "hero",
                    "banner",
                    "richText",
                    "imageSet",
                    "ctaLink",
                    "showcase"
                  ]
                },
                "dataSource": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "attachTo": {
                  "type": "string",
                  "minLength": 1
                },
                "slice": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "operationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categoryRef",
        "confidence"
      ],
      "properties": {
        "categoryRef": {
          "type": "string",
          "minLength": 1
        },
        "styleRef": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "alternates": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categoryRef",
              "confidence"
            ],
            "properties": {
              "categoryRef": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "experienceRef": {
          "type": "string",
          "minLength": 1
        },
        "templateReady": {
          "type": "boolean"
        },
        "classificationNote": {
          "type": "string"
        }
      }
    },
    "sliceHash": {
      "type": "string"
    }
  }
}

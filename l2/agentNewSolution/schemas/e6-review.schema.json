{
  "$id": "https://collab.codes/schemas/agentNewSolution/e6-review/2026-08-09-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "moduleName", "userLanguage", "title", "reviewRound", "analysisSummary", "recommendations", "changeSummary"],
  "properties": {
    "planId": { "const": "e6-composition-review" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "userLanguage": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "analysisSummary": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "purpose", "decision"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "kind": { "type": "string", "enum": ["horizontalModule", "plugin"] },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "enum": ["include", "defer"] }
        }
      }
    },
    "changeSummary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

{
  "$id": "https://collab.codes/schemas/agentNewSolution/e4-review/2026-08-11-v6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "moduleName",
    "userLanguage",
    "title",
    "reviewRound",
    "solutionMode",
    "businessDomain",
    "entities",
    "relationships",
    "changeSummary"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "const": "e4-ontology-review"
    },
    "moduleName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "userLanguage": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviewRound": {
      "type": "integer",
      "minimum": 1
    },
    "solutionMode": {
      "type": "string",
      "const": "new"
    },
    "businessDomain": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "changeSummary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journeyIds",
        "featureIds",
        "authorityRefs"
      ],
      "properties": {
        "journeyIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "featureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorityRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraintId",
        "kind",
        "value",
        "description",
        "source"
      ],
      "properties": {
        "constraintId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "min",
            "max",
            "minLength",
            "maxLength",
            "pattern",
            "enum",
            "format",
            "unique",
            "custom"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "database",
            "journey",
            "user",
            "inferred",
            "legacyCode"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "title",
        "type",
        "required",
        "description",
        "constraints"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "uuid",
            "string",
            "text",
            "number",
            "integer",
            "boolean",
            "money",
            "date",
            "datetime",
            "json"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        }
      }
    },
    "lifecyclePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicateId",
        "description",
        "stateIds",
        "source"
      ],
      "properties": {
        "predicateId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "stateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "database",
            "journey",
            "user",
            "inferred",
            "legacyCode"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "title",
        "description",
        "kind",
        "ownership",
        "party",
        "sourceRefs",
        "fields",
        "lifecycleStates",
        "lifecyclePredicates",
        "useRules",
        "storage"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "core",
            "event",
            "supporting",
            "mdm",
            "projection",
            "valueObject"
          ]
        },
        "ownership": {
          "type": "string",
          "enum": [
            "moduleOwned",
            "external",
            "derived"
          ]
        },
        "party": {
          "type": "string",
          "enum": [
            "person",
            "organization",
            "none"
          ]
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "lifecycleStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initialState": {
          "type": "string",
          "minLength": 1
        },
        "terminalStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecyclePredicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecyclePredicate"
          }
        },
        "useRules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "scope",
            "notes"
          ],
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "mdm",
                "moduleDatabase",
                "derived",
                "external",
                "embedded"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "organization",
                "module",
                "platform",
                "none"
              ]
            },
            "idField": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "mdmType": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*\\.[A-Z][A-Za-z0-9]*$"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycleStates": {
                "minItems": 1
              }
            },
            "required": [
              "lifecycleStates"
            ]
          },
          "then": {
            "required": [
              "initialState"
            ]
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId",
        "fromEntity",
        "toEntity",
        "type",
        "required",
        "description",
        "persistence",
        "realization"
      ],
      "properties": {
        "relationshipId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "fromEntity": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "toEntity": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "oneToOne",
            "oneToMany",
            "manyToOne",
            "manyToMany"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "mdmRelationship",
                "moduleReference",
                "crossStoreReference",
                "derivedJoin",
                "externalReference",
                "embedded"
              ]
            }
          }
        },
        "realization": {
          "$ref": "#/$defs/relationshipRealization"
        }
      }
    },
    "relationshipEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "fieldIds"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "fieldIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        }
      }
    },
    "relationshipRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ownerEntity",
        "from",
        "to",
        "description"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fieldReference",
            "fieldCollection",
            "mdmRelationship",
            "derived",
            "externalReference",
            "embedded"
          ]
        },
        "ownerEntity": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "from": {
          "$ref": "#/$defs/relationshipEndpoint"
        },
        "to": {
          "$ref": "#/$defs/relationshipEndpoint"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

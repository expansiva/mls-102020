{
  "$id": "https://collab.codes/schemas/agentNewSolution/e5-review/2026-08-09-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "moduleName", "userLanguage", "title", "reviewRound", "rules", "changeSummary"],
  "properties": {
    "planId": { "const": "e5-rules-review" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "userLanguage": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changeSummary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

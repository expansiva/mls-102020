{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/agentDefsL2/sharedJudgmentV1.json",
  "title": "agentDefsL2 shared40 page judgment",
  "description": "LLM-owned logical sequencing only. Input sources are code-owned: selected identity is non-editable selection, ordinary fields are user input, and session/route sources may only come from future trusted structured context. No layout vocabulary is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "scenaries", "initialLoadActionIds", "actionBehaviors"],
  "properties": {
    "schemaVersion": { "const": "2026-09-21-agent-defs-l2-shared-judgment-v1" },
    "pageId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "scenaries": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["value", "kind", "actionId", "preconditions"], "properties": {
        "value": { "type": "string", "minLength": 1 }, "kind": { "enum": ["base", "detail", "command"] }, "actionId": { "type": "string", "minLength": 1 }, "preconditions": { "description": "Copy only exact stateKey strings from preconditionStateKeysByAction[actionId] in the human prompt, or use an empty array. Never use labels, scenary values, or actionIds.", "type": "array", "items": { "type": "string", "pattern": "^ui\\." }, "uniqueItems": true }
      } }
    },
    "initialLoadActionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "actionBehaviors": {
      "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["actionId", "refreshActionIds", "destructive"], "properties": {
        "actionId": { "type": "string", "minLength": 1 }, "refreshActionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "destructive": { "type": "boolean" },
        "confirmation": { "type": "object", "additionalProperties": false, "required": ["title", "description"], "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } }
      } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/agentDefsL2/pagesJudgmentV4.json",
  "title": "agentDefsL2 page and molecule role judgment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "pageIntent", "category", "presentations", "moleculeResearch"],
  "properties": {
    "schemaVersion": { "const": "2026-09-29-agent-defs-l2-pages-judgment-v5" },
    "pageIntent": { "type": "string", "minLength": 1 },
    "pageId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryRef", "reason", "evidenceRefs"],
      "properties": {
        "categoryRef": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "presentations": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["device", "descriptions"],
        "properties": {
          "device": { "enum": ["desktop", "mobile"] },
          "descriptions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["organismId", "kind", "description", "outputFieldRefs"],
              "properties": {
                "organismId": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "contentRef": { "type": "string" },
                "capabilityRefs": { "type": "array", "items": { "type": "string" } },
                "outputFieldRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "moleculeResearch": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["needId", "roles"],
        "properties": {
          "needId": { "type": "string", "minLength": 1 },
          "noMatchReason": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["role", "groupId", "preferred", "discardedCandidates"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "groupId": { "type": "string", "minLength": 1 },
                "preferred": { "$ref": "#/$defs/option" },
                "alternative": { "$ref": "#/$defs/option" },
                "discardedCandidates": {
                  "type": "array", "items": { "$ref": "#/$defs/option" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["tag", "reason"],
      "properties": { "tag": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/agentDefsL2/moleculeGroupsV1.json",
  "title": "agentDefsL2 selective molecule group assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "moleculeResearch"],
  "properties": {
    "schemaVersion": { "const": "2026-09-29-d2-molecule-groups-v1" },
    "pageId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "moleculeResearch": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["needId", "groups"],
        "properties": {
          "needId": { "type": "string", "minLength": 1 },
          "groups": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["groupId", "relevant", "reason"],
              "properties": {
                "groupId": { "type": "string", "minLength": 1 },
                "relevant": { "type": "boolean" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}

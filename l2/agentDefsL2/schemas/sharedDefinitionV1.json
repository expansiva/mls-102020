{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/agentDefsL2/sharedDefinitionV1.json",
  "title": "agentDefsL2 public shared definition",
  "description": "Semantic, device-independent page behavior. Contract refs are authoritative; no DTO expansion, source hashes, or pipeline metadata are public.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "pageId", "intent", "references", "contractRef", "states", "actions", "contents", "scenarios", "authorityRefs"],
  "properties": {
    "schemaVersion": { "const": "2026-09-29-agent-defs-l2-definition-v1" },
    "artifactType": { "const": "shared" },
    "pageId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "intent": { "type": "string", "minLength": 1 },
    "references": { "$ref": "#/$defs/references" },
    "contractRef": { "$ref": "#/$defs/reference" },
    "authorityRefs": { "$ref": "#/$defs/references" },
    "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "contents": { "type": "array", "items": { "$ref": "#/$defs/content" } },
    "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["purpose", "fileRef"],
      "properties": { "purpose": { "type": "string", "minLength": 1 }, "fileRef": { "type": "string", "minLength": 1 }, "fragment": { "type": "string", "minLength": 1 } }
    },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["id", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "purpose": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/reference" }, "typeRef": { "$ref": "#/$defs/reference" },
        "uiType": { "enum": ["string", "number", "boolean", "object", "string[]"] },
        "initialValue": { "type": ["string", "number", "boolean", "null"] },
        "required": { "type": "boolean" }, "values": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } },
        "selection": { "type": "object", "additionalProperties": false, "required": ["sourceActionRef", "resultStateRef", "identityRef"], "properties": { "sourceActionRef": { "$ref": "#/$defs/id" }, "resultStateRef": { "$ref": "#/$defs/id" }, "identityRef": { "$ref": "#/$defs/reference" } } },
        "snapshot": { "type": "object", "additionalProperties": false, "required": ["sourceActionRef", "resultStateRef", "selectedIdentityStateRef", "identityRef", "valueRef", "capture", "missing"], "properties": { "sourceActionRef": { "$ref": "#/$defs/id" }, "resultStateRef": { "$ref": "#/$defs/id" }, "selectedIdentityStateRef": { "$ref": "#/$defs/id" }, "identityRef": { "$ref": "#/$defs/reference" }, "valueRef": { "$ref": "#/$defs/reference" }, "capture": { "const": "onSelection" }, "missing": { "const": "blockCommandPreserveEdit" } } },
        "source": { "enum": ["userInput", "selectedEntity", "routeParam", "session"] }, "presentation": { "enum": ["form", "selection", "route", "hidden"] }, "editable": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["id", "callRef", "inputs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "callRef": { "$ref": "#/$defs/reference" },
        "inputs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["parameterRef", "stateRef"], "properties": { "parameterRef": { "$ref": "#/$defs/reference" }, "stateRef": { "$ref": "#/$defs/id" } } } },
        "resultStateRef": { "$ref": "#/$defs/id" }, "statusStateRef": { "$ref": "#/$defs/id" }, "errorStateRef": { "$ref": "#/$defs/id" },
        "refreshActionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "authorityRefs": { "$ref": "#/$defs/references" },
        "initialLoad": { "type": "boolean" },
        "transitions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["actorRef", "id", "from", "to", "by", "payload"], "properties": { "actorRef": { "$ref": "#/$defs/id" }, "id": { "type": "string", "minLength": 1 }, "from": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "to": { "type": "string", "minLength": 1 }, "by": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "payload": { "type": "array", "items": { "type": "string" } } } } },
        "confirmation": { "type": "object", "additionalProperties": false, "required": ["title", "description"], "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } }
      }
    },
    "content": {
      "type": "object", "additionalProperties": false, "required": ["id", "intent", "inactiveBehavior"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "intent": { "type": "string", "minLength": 1 }, "actionRef": { "$ref": "#/$defs/id" }, "visibleWhen": { "$ref": "#/$defs/references" }, "stateRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "inactiveBehavior": { "const": "hiddenInertOutOfFocus" } }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "contentRefs", "preconditions"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "actionRef": { "$ref": "#/$defs/id" }, "contentRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "preconditions": { "$ref": "#/$defs/references" } }
    },
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" }
  }
}

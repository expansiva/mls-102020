{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/agentDefsL2/pagesJudgmentV2.json",
  "title": "agentDefsL2 pages50 page judgment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "category", "presentations"],
  "properties": {
    "schemaVersion": { "const": "2026-09-23-agent-defs-l2-pages-judgment-v2" },
    "pageId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]*$" },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryRef", "reason", "evidenceRefs"],
      "properties": {
        "categoryRef": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "presentations": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["device", "descriptions", "capabilityRefs", "groupIds", "moleculeRecommendations", "moleculeReason"],
        "properties": {
          "device": { "enum": ["desktop", "mobile"] },
          "descriptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "capabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "groupIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "moleculeRecommendations": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["groupId", "candidates", "reason"],
              "properties": {
                "groupId": { "type": "string", "minLength": 1 },
                "candidates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "moleculeReason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

  "endpoints": [
    {
      "id": "listAuditFilterBots",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "bots",
          "type": "AuditBotRef[]"
        }
      ],
      "rules": [
        "auditAdminOnly",
        "adminOnlyScreens",
        "botNeverDeleted"
      ],
      "jsdoc": {
        "purpose": "Gives the bots of the company that can be chosen to filter the audit.",
        "input": "None; the company comes from the logged-in admin.",
        "processing": "Lists every bot of the organization in any situation, deactivated included (botNeverDeleted keeps their audit readable), ordered by name. Only the company admin may call it (auditAdminOnly, adminOnlyScreens).",
        "output": "The bots with id and name."
      }
    },
    {
      "id": "searchAuditConversations",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "text",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "botId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.botId"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "conversations",
          "type": "AuditConversationRef[]",
          "paginated": true
        }
      ],
      "rules": [
        "adminOnlyScreens",
        "showAnonymousWhenUnidentified"
      ],
      "jsdoc": {
        "purpose": "Finds conversations to choose as the conversation filter of the audit.",
        "input": "text: part of the name on Telegram or of the identification; botId: optional bot whose conversations are searched; page and pageSize: the page asked.",
        "processing": "Searches the organization's conversations whose telegramName or identificationName contains the text, restricted to the bot when given, ordered by last message date. identificationShown is computed: the cm identification name or 'Anonymous' when there is none (showAnonymousWhenUnidentified). Company admin only (adminOnlyScreens).",
        "output": "A page of conversations with id, name on Telegram and name shown."
      }
    },
    {
      "id": "listAuditRecords",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "writtenFrom",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.writtenAt"
            ]
          }
        },
        {
          "name": "writtenTo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.writtenAt"
            ]
          }
        },
        {
          "name": "botId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.botId"
            ]
          }
        },
        {
          "name": "conversationId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.conversationId"
            ]
          }
        },
        {
          "name": "direction",
          "type": "'incoming' | 'outgoing'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.direction"
            ]
          }
        },
        {
          "name": "result",
          "type": "'delivered' | 'refused' | 'failed'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.result"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "records",
          "type": "AuditRow[]",
          "paginated": true
        },
        {
          "name": "matchingCount",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "MessageAudit.id"
            ]
          }
        }
      ],
      "rules": [
        "auditAdminOnly",
        "auditRetention90Days",
        "auditEveryMessage",
        "showAnonymousWhenUnidentified"
      ],
      "jsdoc": {
        "purpose": "Lists the audit records of the company's bots that match the admin's filters, newest written first.",
        "input": "writtenFrom and writtenTo: the period of the time the message was written; botId, conversationId, direction and result: optional filters; page and pageSize: the page asked.",
        "processing": "Filters the organization's MessageAudit records by writtenAt within the period and by the given bot, conversation, direction and result, ordered by writtenAt descending. Only records still kept are listed: erased 90 days after written (auditRetention90Days). Joins the bot name and the conversation name on Telegram and identificationShown ('Anonymous' when unidentified, showAnonymousWhenUnidentified); a refused send without conversation has none. authorDisplay is computed: the author name or 'Anonymous'. matchingCount counts all records matching the same filters. Company admin only (auditAdminOnly).",
        "output": "A page of audit rows with when written, bot, conversation, author shown, direction, result and reason code, plus the number of records matching the filters."
      }
    },
    {
      "id": "listAuditTimeline",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "writtenFrom",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.writtenAt"
            ]
          }
        },
        {
          "name": "writtenTo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.writtenAt"
            ]
          }
        },
        {
          "name": "botId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.botId"
            ]
          }
        },
        {
          "name": "conversationId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.conversationId"
            ]
          }
        },
        {
          "name": "direction",
          "type": "'incoming' | 'outgoing'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.direction"
            ]
          }
        },
        {
          "name": "result",
          "type": "'delivered' | 'refused' | 'failed'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.result"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "entries",
          "type": "AuditTimelineEntry[]",
          "paginated": true
        }
      ],
      "rules": [
        "auditAdminOnly",
        "auditRetention90Days",
        "showAnonymousWhenUnidentified",
        "longTextSentInParts"
      ],
      "jsdoc": {
        "purpose": "Gives the messages matching the audit filters in the order they were written, to follow the exchange.",
        "input": "The same filters as the audit list: period of writtenAt, bot, conversation, direction, result; page and pageSize: the page asked.",
        "processing": "Filters the organization's MessageAudit records still kept (auditRetention90Days) like the list, ordered by writtenAt ascending. Includes the text, the author shown (computed, 'Anonymous' when no name), the bot name and the conversation name shown ('Anonymous' when unidentified, showAnonymousWhenUnidentified), and for refused or failed records the reason code and message. A long text sent in parts stays one entry (longTextSentInParts). Company admin only (auditAdminOnly).",
        "output": "A page of timeline entries, oldest first, with direction, result, author shown, text, reason, bot and conversation."
      }
    },
    {
      "id": "getAuditRecord",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "record",
          "type": "AuditRecordDetail"
        }
      ],
      "rules": [
        "auditAdminOnly",
        "auditRetention90Days",
        "showAnonymousWhenUnidentified",
        "longTextSentInParts",
        "auditAppendOnly"
      ],
      "jsdoc": {
        "purpose": "Opens one audit record in full.",
        "input": "id: the audit record chosen in the list or the timeline.",
        "processing": "Reads the MessageAudit record of the organization by id (read-only, auditAppendOnly) with its bot (name and current situation), its conversation (name on Telegram, name shown and current situation) and the cm agent name that was answering. Computes authorDisplay ('Anonymous' when no author name), identificationShown ('Anonymous' when unidentified, showAnonymousWhenUnidentified) and expiresOn as writtenAt plus 90 days (auditRetention90Days). Returns the parts with their sequence and result when the text was sent in parts (longTextSentInParts). Company admin only (auditAdminOnly); a record already erased is not found.",
        "output": "The audit record with when written and recorded, direction, author account and name, text, message kind, result with reason, parts, erase day, bot, conversation and answering agent."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "auditList",
        "reads": "listAuditRecords.records"
      },
      {
        "organism": "auditList",
        "reads": "listAuditRecords.matchingCount"
      },
      {
        "organism": "auditList",
        "reads": "listAuditFilterBots.bots"
      },
      {
        "organism": "auditList",
        "reads": "searchAuditConversations.conversations"
      },
      {
        "organism": "auditRecord",
        "reads": "getAuditRecord.record"
      },
      {
        "organism": "auditTimeline",
        "reads": "listAuditTimeline.entries"
      }
    ],
    "commands": [],
    "selections": [

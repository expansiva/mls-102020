  "endpoints": [
    {
      "id": "getConversationsPage",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "botId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.botId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'blocked'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.status"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "conversations",
          "type": "ConversationRow[]",
          "paginated": true
        },
        {
          "name": "bots",
          "type": "Bot[]"
        },
        {
          "name": "agents",
          "type": "CmAgent[]"
        }
      ],
      "rules": [
        "adminOnlyScreens",
        "showAnonymousWhenUnidentified",
        "agentChosenFromCm"
      ],
      "jsdoc": {
        "purpose": "Opens the conversations screen in one call: the first page of conversations, the company's bots used as filter and as target of bot actions, and the cm agents that can answer a bot.",
        "input": "botId: optional bot to filter by (from the URL). status: optional situation filter. page/pageSize: paging of the conversation list.",
        "processing": "Company admin only (adminOnlyScreens). Lists the organization's conversations filtered by bot and situation, ordered by lastMessageAt newest first, each with its bot and the bot's cm agent. identificationShown is computed: identificationName or 'Anonymous' when empty (showAnonymousWhenUnidentified). Bots are listed by name with their agent name. Agents are read from the cm agent list (agentChosenFromCm).",
        "output": "conversations: a page of conversation summaries with bot and agent; bots: all bots with situation and agent; agents: the cm agents available."
      }
    },
    {
      "id": "searchConversations",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "botId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.botId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'blocked'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.status"
            ]
          }
        },
        {
          "name": "chatKind",
          "type": "'person' | 'group'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.chatKind"
            ]
          }
        },
        {
          "name": "search",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "conversations",
          "type": "ConversationRow[]",
          "paginated": true
        }
      ],
      "rules": [
        "adminOnlyScreens",
        "showAnonymousWhenUnidentified"
      ],
      "jsdoc": {
        "purpose": "Finds conversations by bot, situation, person or group and text, page by page.",
        "input": "botId: bot filter. status: open or blocked. chatKind: person or group. search: text contained in the name on Telegram or the identification. page/pageSize: paging.",
        "processing": "Company admin only. Filters the organization's conversations by the given filters and by search over telegramName and identificationName, ordered by lastMessageAt newest first. identificationShown is computed as identificationName or 'Anonymous' (showAnonymousWhenUnidentified).",
        "output": "A page of conversation summaries, each with its bot, the bot's situation and its answering agent."
      }
    },
    {
      "id": "getConversation",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.id"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "conversation",
          "type": "Conversation"
        },
        {
          "name": "timeline",
          "type": "TimelineEntry[]",
          "paginated": true
        }
      ],
      "rules": [
        "adminOnlyScreens",
        "showAnonymousWhenUnidentified",
        "onlyActiveBotCarriesMessages",
        "blockedConversationRefusesMessages",
        "auditAdminOnly",
        "auditRetention90Days"
      ],
      "jsdoc": {
        "purpose": "Opens the chosen conversation with everything the focus and history sections show.",
        "input": "id: the conversation picked in the list. pageSize: size of the first timeline page.",
        "processing": "Reads the conversation by id with its bot, identification and latest block. Computes canSend = status open and bot active (onlyActiveBotCarriesMessages, blockedConversationRefusesMessages), isAnonymous and identificationShown ('Anonymous' when no identification). Lists the first page of the conversation's audit records ordered by writtenAt; only records still kept (auditRetention90Days) and only for the company admin (auditAdminOnly). authorDisplay is computed from the author name or 'Anonymous'.",
        "output": "conversation: the conversation in its current state with bot, identification and block; timeline: the first page of its audit records."
      }
    },
    {
      "id": "listConversationTimeline",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "conversationId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "MessageAudit.conversationId"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "timeline",
          "type": "TimelineEntry[]",
          "paginated": true
        }
      ],
      "rules": [
        "auditAdminOnly",
        "auditRetention90Days"
      ],
      "jsdoc": {
        "purpose": "Brings further pages of the conversation's history.",
        "input": "conversationId: the open conversation. page/pageSize: paging.",
        "processing": "Lists the audit records of the conversation ordered by writtenAt, company admin only (auditAdminOnly), records still kept within 90 days (auditRetention90Days). authorDisplay is computed from the author name or 'Anonymous'.",
        "output": "A page of audit records of the conversation."
      }
    },
    {
      "id": "changeBotAgent",
      "kind": "cmd",
      "when": "changeBotAgent",
      "writes": "TelegramBot.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramBot.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramBot.version"
            ]
          }
        },
        {
          "name": "agentId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramBot.agentId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "bot",
          "type": "Bot"
        }
      ],
      "rules": [
        "agentChosenFromCm",
        "adminOnlyScreens"
      ],
      "jsdoc": {
        "purpose": "Makes another cm agent answer the conversations of the bot the list is filtered by.",
        "input": "id and version: the bot and the version the admin saw. agentId: the chosen cm agent.",
        "processing": "Company admin only. Refuses an agent that is not among the cm's agents (agentChosenFromCm) and a stale version. Updates TelegramBot.agentId.",
        "output": "The bot in its new state with the new agent and its name."
      }
    },
    {
      "id": "deactivateBot",
      "kind": "cmd",
      "when": "deactivateBot",
      "writes": "TelegramBot.deactivate",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramBot.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramBot.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "bot",
          "type": "Bot"
        }
      ],
      "rules": [
        "botNeverDeleted",
        "onlyActiveBotCarriesMessages",
        "adminOnlyScreens"
      ],
      "jsdoc": {
        "purpose": "Retires the bot the list is filtered by.",
        "input": "id and version: the bot and the version the admin saw.",
        "processing": "Company admin only. Applies the deactivate transition from notConfigured, active or paused; refuses other situations and a stale version. The bot is never deleted (botNeverDeleted): its conversations and audit stay readable; it stops carrying messages (onlyActiveBotCarriesMessages).",
        "output": "The bot in the deactivated situation with its agent."
      }
    },
    {
      "id": "blockConversation",
      "kind": "cmd",
      "when": "blockConversation",
      "writes": "TelegramConversation.block",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.version"
            ]
          }
        },
        {
          "name": "details.block.reason",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.details.block.reason"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "conversation",
          "type": "Conversation"
        }
      ],
      "rules": [
        "blockRequiresReason",
        "blockedConversationRefusesMessages",
        "adminOnlyScreens"
      ],
      "jsdoc": {
        "purpose": "Blocks an open conversation so no message flows to or from it.",
        "input": "id and version: the conversation and the version seen. details.block.reason: why it is blocked.",
        "processing": "Company admin only. Refuses an empty reason (blockRequiresReason), a conversation not open and a stale version. Applies the block transition recording blockedBy companyAdmin, blockedAt now and the reason. From then on messages are refused (blockedConversationRefusesMessages); canSend is computed again.",
        "output": "The conversation in the blocked situation with its block, bot and computed flags."
      }
    },
    {
      "id": "unblockConversation",
      "kind": "cmd",
      "when": "unblockConversation",
      "writes": "TelegramConversation.unblock",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TelegramConversation.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "conversation",
          "type": "Conversation"
        }
      ],
      "rules": [
        "cmBlockUndoneOnlyByAdmin",
        "adminOnlyScreens"
      ],
      "jsdoc": {
        "purpose": "Reopens a blocked conversation, including one blocked by the cm.",
        "input": "id and version: the conversation and the version seen.",
        "processing": "Company admin only; a block by the cm can be undone only by the admin (cmBlockUndoneOnlyByAdmin). Refuses a conversation not blocked and a stale version. Applies the unblock transition and records unblockedAt on the block; canSend is computed again.",
        "output": "The conversation in the open situation with its last block and computed flags."

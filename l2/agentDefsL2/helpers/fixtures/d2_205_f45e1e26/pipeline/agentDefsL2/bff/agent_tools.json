{
  "types": [
    {
      "name": "ToolDetails",
      "description": "Readable placement and explanation of one catalog action.",
      "fields": [
        {
          "name": "moduleTitle",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.details.moduleTitle"
            ]
          }
        },
        {
          "name": "subjectTitle",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.details.subjectTitle"
            ]
          }
        },
        {
          "name": "description",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.details.description"
            ]
          }
        },
        {
          "name": "removedAt",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.details.removedAt"
            ]
          }
        }
      ]
    },
    {
      "name": "AgentToolChoiceDetails",
      "description": "When and by whom a tool choice of an agent was made, and the state of the tool it refers to.",
      "fields": [
        {
          "name": "decidedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.details.decidedAt"
            ]
          }
        },
        {
          "name": "decidedBy",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.details.decidedBy"
            ]
          }
        },
        {
          "name": "automaticOrigin",
          "type": "'draftSuggestion' | 'catalogRefresh'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.details.automaticOrigin"
            ]
          }
        },
        {
          "name": "toolName",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.details.toolName"
            ]
          }
        },
        {
          "name": "toolRemoved",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.details.toolRemoved"
            ]
          }
        }
      ]
    },
    {
      "name": "AgentToolChoice",
      "description": "The on or off choice of one tool for one agent, with who made it.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.version"
            ]
          }
        },
        {
          "name": "enabled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.enabled"
            ]
          }
        },
        {
          "name": "choiceSource",
          "type": "'admin' | 'automatic'",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.choiceSource"
            ]
          }
        },
        {
          "name": "details",
          "type": "AgentToolChoiceDetails"
        }
      ]
    },
    {
      "name": "ToolTreeAction",
      "description": "One action of the tool catalog in the module / subject / action tree, with the agent's choice for it when one exists.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.id"
            ]
          }
        },
        {
          "name": "moduleName",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.moduleName"
            ]
          }
        },
        {
          "name": "subject",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.subject"
            ]
          }
        },
        {
          "name": "name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.name"
            ]
          }
        },
        {
          "name": "status",
          "type": "'available' | 'removed'",
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "ToolDetails"
        },
        {
          "name": "agentTool",
          "type": "AgentToolChoice",
          "optional": true
        }
      ]
    },
    {
      "name": "ToolReleaseDetails",
      "description": "The release in which a catalog tool was last found.",
      "fields": [
        {
          "name": "releaseLabel",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Tool.details.releaseLabel"
            ]
          }
        }
      ]
    },
    {
      "name": "ToolRelease",
      "description": "Release information of the catalog tool a choice refers to.",
      "fields": [
        {
          "name": "details",
          "type": "ToolReleaseDetails"
        }
      ]
    },
    {
      "name": "AutomaticToolChoice",
      "description": "A tool choice of an agent made by an automatic step, with the release of its tool.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.id"
            ]
          }
        },
        {
          "name": "enabled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.enabled"
            ]
          }
        },
        {
          "name": "choiceSource",
          "type": "'admin' | 'automatic'",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.choiceSource"
            ]
          }
        },
        {
          "name": "details",
          "type": "AgentToolChoiceDetails"
        },
        {
          "name": "tool",
          "type": "ToolRelease"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "getAgentToolTree",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "agentId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Agent.name"
            ]
          }
        },
        {
          "name": "actions",
          "type": "ToolTreeAction[]"
        }
      ],
      "rules": [
        "agentToolsShowWholeCatalog",
        "noTechnicalIdsOnScreen",
        "removedToolNeverSent"
      ],
      "jsdoc": {
        "purpose": "Loads the agent's name and the whole tool catalog as module / subject / action entries, each with the agent's current choice for it.",
        "input": "agentId: the cm id of the agent opened from the URL.",
        "processing": "Reads the agent name from the cm. Reads every tool of the catalog (available and removed, per agentToolsShowWholeCatalog) via agents.toolTree, and all tool choices of the agent in one listByForeignKey read, joining them by tool. Sorted by module title, subject title and action name. decidedBy is resolved to the admin's readable name via read.mdmRecord (noTechnicalIdsOnScreen); toolName and toolRemoved are derived from the catalog at read time (removedToolNeverSent: removed tools are shown as removed). Tool.toolKey and catalogItem are never returned.",
        "output": "name and the list of every catalog action with its readable names, description, status and removal date, plus agentTool (id, version, on/off, who chose, when) when the agent has a choice for it."
      }
    },
    {
      "id": "listAutomaticToolChoices",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "agentId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "choices",
          "type": "AutomaticToolChoice[]"
        }
      ],
      "rules": [
        "adminChoiceNeverOverridden",
        "draftSuggestedToolsTurnedOn",
        "newToolsChosenFromDescription"
      ],
      "jsdoc": {
        "purpose": "Lists the tool choices of the agent that were made automatically, newest first.",
        "input": "agentId: the cm id of the agent opened from the URL.",
        "processing": "Locates the agent's tool choices with choiceSource = automatic (locate.byColumn), ordered by decidedAt descending. Joins the tool to read its releaseLabel; toolName and toolRemoved are derived from the catalog. Choices the admin has made are never listed here, since adminChoiceNeverOverridden keeps them out of automatic steps.",
        "output": "The automatic choices with on/off, automatic origin (draft suggestion or catalog refresh), when, tool name, removed mark and the release label of the tool."
      }
    },
    {
      "id": "enableUnchosenTool",
      "kind": "cmd",
      "when": "enableUnchosenTool",
      "writes": "AgentTool.create",
      "input": [
        {
          "name": "agentId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.agentId"
            ]
          }
        },
        {
          "name": "toolId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.toolId"
            ]
          }
        },
        {
          "name": "enabled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.enabled"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "action",
          "type": "ToolTreeAction"
        }
      ],
      "rules": [
        "markingWithoutChoiceCreatesAdminChoice",
        "oneChoicePerAgentAndTool",
        "adminChoiceNeverOverridden"
      ],
      "jsdoc": {
        "purpose": "Creates the agent's first choice for a catalog action the admin has just ticked.",
        "input": "agentId: cm id of the agent; toolId: the catalog action ticked; enabled: the ticked state, true.",
        "processing": "Per markingWithoutChoiceCreatesAdminChoice, creates the AgentTool for this agent and tool as on with choiceSource = admin and decidedBy = the logged admin; decidedAt is filled by the system. oneChoicePerAgentAndTool: refuses when a choice already exists for this pair (the page must then use toggleToolChoice). Being an admin choice, it is never changed by later automatic steps (adminChoiceNeverOverridden).",
        "output": "The catalog action with its tool data and its new agentTool choice, on, chosen by the admin, with id and version."
      }
    },
    {
      "id": "toggleToolChoice",
      "kind": "cmd",
      "when": "toggleToolChoice",
      "writes": "AgentTool.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.version"
            ]
          }
        },
        {
          "name": "toolId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.toolId"
            ]
          }
        },
        {
          "name": "enabled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "AgentTool.enabled"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "action",
          "type": "ToolTreeAction"
        }
      ],
      "rules": [
        "markingWithoutChoiceCreatesAdminChoice",
        "adminChoiceNeverOverridden",
        "oneChoicePerAgentAndTool"
      ],
      "jsdoc": {
        "purpose": "Turns an existing tool choice of the agent on or off.",
        "input": "id and version: the existing choice and the version the page holds; toolId: the catalog action the choice refers to, checked against the stored choice and never changed; enabled: the new on/off value.",
        "processing": "Checks the version (optimistic concurrency) and that the choice refers to toolId. Changes only enabled, sets choiceSource = admin and decidedBy = the logged admin; decidedAt is refreshed by the system. From then on no automatic step changes this choice (adminChoiceNeverOverridden). No new choice is created (markingWithoutChoiceCreatesAdminChoice, oneChoicePerAgentAndTool).",
        "output": "The catalog action with its tool data and the updated agentTool choice in its new state and version."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "agentToolTree",
        "reads": "getAgentToolTree.name"
      },
      {
        "organism": "agentToolTree",
        "reads": "getAgentToolTree.actions"
      },
      {
        "organism": "automaticToolChoices",
        "reads": "listAutomaticToolChoices.choices"
      }
    ],
    "commands": [
      {
        "endpoint": "enableUnchosenTool",
        "refreshes": []
      },
      {
        "endpoint": "toggleToolChoice",
        "refreshes": [
          "listAutomaticToolChoices"
        ]
      }
    ],
    "selections": [],
    "journeys": [
      {
        "step": "adjustAgentTools/findAgentForTools",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "agents"
      },
      {
        "step": "adjustAgentTools/browseToolTree",
        "organisms": [
          "agentToolTree",
          "automaticToolChoices"
        ],
        "endpoints": [
          "getAgentToolTree",
          "listAutomaticToolChoices"
        ]
      },
      {
        "step": "adjustAgentTools/enableUnchosenTool",
        "organisms": [
          "agentToolTree"
        ],
        "endpoints": [
          "enableUnchosenTool"
        ]
      },
      {
        "step": "adjustAgentTools/toggleTools",
        "organisms": [
          "agentToolTree"
        ],
        "endpoints": [
          "toggleToolChoice"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "enableUnchosenTool",
        "state": "getAgentToolTree.actions",
        "mode": "upsert"
      },
      {
        "endpoint": "toggleToolChoice",
        "state": "getAgentToolTree.actions",
        "mode": "upsert"
      }
    ]
  }
}

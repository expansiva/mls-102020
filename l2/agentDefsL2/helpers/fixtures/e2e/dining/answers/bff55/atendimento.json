        ],
        "endpoints": [
          "buscarItemCardapio"
        ],
        "continuesIn": ""
      },
      {
        "step": "lancarItemComanda/adicionarItemComanda",
        "organisms": [
          "formularioLancamento",
          "acoesAtendimento"
        ],
        "endpoints": [
          "lancarItem"
        ],
        "continuesIn": ""
      },
      {
        "step": "cancelarItemComanda/localizarComandaParaCorrecao",
        "organisms": [
          "lookupAtendimento"
        ],
        "endpoints": [
          "carregarComanda"
        ],
        "continuesIn": ""
      },
      {
        "step": "cancelarItemComanda/conferirItemLancado",
        "organisms": [
          "detalheComanda"
        ],
        "endpoints": [
          "carregarComanda"
        ],
        "continuesIn": ""
      },
      {
        "step": "cancelarItemComanda/cancelarItemErrado",
        "organisms": [

  "endpoints": [
    {
      "id": "carregarAtendimento",
      "kind": "qry",
      "when": "onLoad",
      "writes": "",
      "input": [],
      "output": [
        {
          "name": "mesas",
          "type": "MesaDoSalao[]",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Abrir a tela do garçom com as mesas do salão e as comandas abertas nelas.",
        "input": "Nenhuma.",
        "processing": "Todas as mesas da organização com a disponibilidade calculada; para cada mesa ocupada, a comanda com status open, o número e o subtotal calculado.",
        "output": "mesas."
      }
    },
    {
      "id": "carregarComanda",
      "kind": "qry",
      "when": "interaction",
      "writes": "",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaComItens",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [
        "valorTotalItemComandaCalculado",
        "subtotalComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Mostrar a comanda escolhida para conferência antes de lançar ou cancelar.",
        "input": "id da comanda selecionada.",
        "processing": "A comanda com os itens lançados e cancelados, o nome do item do cardápio de cada um e o subtotal calculado pelos itens não cancelados (subtotalComandaCalculado).",
        "output": "comanda (ComandaComItens)."
      }
    },
    {
      "id": "buscarItemCardapio",
      "kind": "qry",
      "when": "interaction",
      "writes": "",
      "input": [
        {
          "name": "name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemCardapio.name"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "itens",
          "type": "ItemDoCardapio[]",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Achar o item do cardápio pelo nome enquanto o garçom digita o pedido.",
        "input": "name, parte do nome.",
        "processing": "Até 20 itens cujo nome contém o termo, ordenados pelo nome.",
        "output": "itens com nome e preço vigente."
      }
    },
    {
      "id": "abrirComanda",
      "kind": "cmd",
      "when": "abrirComanda",
      "writes": "Comanda.create",
      "input": [
        {
          "name": "mesaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.mesaId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaComItens",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [
        "mesaDisponivelParaAbrirComanda",
        "umaComandaAbertaPorMesa"
      ],
      "jsdoc": {
        "purpose": "Abrir uma comanda para a mesa escolhida.",
        "input": "mesaId, a mesa disponível.",
        "processing": "Recusa se a mesa não estiver disponível (mesaDisponivelParaAbrirComanda) ou já tiver comanda aberta (umaComandaAbertaPorMesa); o número vem da sequência da plataforma; a comanda nasce open.",
        "output": "comanda (ComandaComItens, sem itens)."
      }
    },
    {
      "id": "lancarItem",
      "kind": "cmd",
      "when": "lancarItem",
      "writes": "ItemComanda.create",
      "input": [
        {
          "name": "comandaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.comandaId"
            ]
          }
        },
        {
          "name": "itemCardapioId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.itemCardapioId"
            ]
          }
        },
        {
          "name": "quantidade",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.quantidade"
            ]
          }
        },
        {
          "name": "observacao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.observacao"
            ]
          },
          "optional": true
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaComItens",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [
        "itensSomenteEmComandaAberta",
        "precoUnitarioRegistradoNoLancamento",
        "valorTotalItemComandaCalculado",
        "subtotalComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Lançar um item do cardápio na comanda aberta.",
        "input": "comandaId, itemCardapioId, quantidade e observação opcional.",
        "processing": "Recusa se a comanda não estiver open (itensSomenteEmComandaAberta); grava o preço vigente do cardápio como preço unitário (precoUnitarioRegistradoNoLancamento); valor total e subtotal são calculados (valorTotalItemComandaCalculado, subtotalComandaCalculado).",
        "output": "comanda (ComandaComItens) atualizada."
      }
    },
    {
      "id": "cancelarItem",
      "kind": "cmd",
      "when": "cancelarItem",
      "writes": "ItemComanda.cancelarItemComanda",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaComItens",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [
        "itemComandaOperacaoSomenteComandaAberta",
        "subtotalComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Cancelar um item lançado por engano.",
        "input": "id e version do item.",
        "processing": "Recusa se a comanda do item não estiver open (itemComandaOperacaoSomenteComandaAberta); o item vai para canceled e o subtotal é calculado de novo (subtotalComandaCalculado).",
        "output": "comanda (ComandaComItens) atualizada."
      }
    }
  ],
  "bindings": {
    "organisms": [

{
  "types": [
    {
      "name": "IndicadoresDoSalao",
      "description": "Indicadores do salão calculados no endpoint.",
      "fields": [
        {
          "name": "mesasLivres",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mesa.details.disponivel"
            ]
          }
        },
        {
          "name": "mesasOcupadas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mesa.details.disponivel"
            ]
          }
        },
        {
          "name": "comandasAbertas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.status"
            ]
          }
        },
        {
          "name": "totalEmAberto",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.status",
              "Comanda.details.subtotal",
              "ItemComanda.details.valorTotal"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarIndicadores",
      "kind": "qry",
      "when": "onLoad",
      "writes": "",
      "input": [],
      "output": [
        {
          "name": "indicadores",
          "type": "IndicadoresDoSalao",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "rules": [
        "valorTotalItemComandaCalculado",
        "subtotalComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Indicadores do salão para o caixa e o garçom decidirem entre atender e fechar.",
        "input": "Nenhuma.",
        "processing": "Conta as mesas disponíveis e as ocupadas; conta as comandas com status open e soma o subtotal calculado delas (subtotalComandaCalculado, valorTotalItemComandaCalculado). Tudo calculado no endpoint; nenhuma lista sai.",
        "output": "indicadores."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "resumoOperacional",
        "reads": "carregarIndicadores.indicadores"
      }
    ],
    "commands": [],
    "selections": [],
    "journeys": []
  }
}

   "functions": [
    "abrirMovimentacoes"
   ],
   "continuesIn": "movimentacoes"
  },
  {
   "step": "tratarAvisoSaldoBaixo/consultarProdutoAvisado",
   "organisms": [
    "alertasSaldoBaixo",
    "detalheProduto"
   ],
   "functions": [
    "selecionarProduto"
   ]
  }
 ],
 "commandReturns": [

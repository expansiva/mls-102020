  },
  {
   "id": "filtrarListaProdutos",
   "description": "Atualiza a lista conforme busca e página.",
   "updates": [
    "filtrosListaProdutos"
   ]
  },
  {
   "id": "cadastrarProduto",
   "description": "Cadastra o produto informado.",
   "calls": "cadastrarProduto",
   "updates": [
    "produtos",
    "detalheProduto"
   ]
  },
  {
   "id": "abrirMovimentacoes",
   "description": "Abre as movimentações do produto selecionado.",

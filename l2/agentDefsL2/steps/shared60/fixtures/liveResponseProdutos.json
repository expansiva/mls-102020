   ]
  },
  {
   "step": "acompanharSaldos/localizarProdutos",
   "organisms": [
    "listaProdutos",
    "detalheProduto"
   ],
   "functions": [
    "filtrarListaProdutos",
    "selecionarProduto"
   ]
  },
  {
   "step": "cadastrarProduto/informarProduto",
   "organisms": [
    "formularioProduto",
    "acoesCadastro"
   ],
   "functions": [
    "cadastrarProduto"
   ]
  },
  {
   "step": "registrarMovimentacaoEstoque/consultarSaldo",

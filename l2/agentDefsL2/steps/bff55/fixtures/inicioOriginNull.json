  "endpoints": [
    {
      "id": "carregarInicio",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "pendencias",
          "type": "PendenciaTarefa[]",
          "origin": null
        },
        {
          "name": "alertas",
          "type": "AlertaPrazo[]",
          "origin": null
        },
        {
          "name": "indicadores",
          "type": "IndicadoresTarefas",
          "origin": null
        },
        {
          "name": "permissoes",
          "type": "PermissoesParticipante",
          "origin": null
        }
      ],
      "rules": [
        "membroVeResponsavelOuCriador",
        "quemAgeAgoraPorSituacao",
        "retomarSoAposDevolucao",
        "tarefaAbertaVencimento",
        "participanteNaoConfiguradoAceitaECria"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez a tela inicial do membro: o que depende dele agora, os prazos de hoje e atrasados, os contadores das suas tarefas e as suas marcas de aceitar e criar tarefas.",
        "input": "Nenhuma entrada; a pessoa da sess\u00e3o \u00e9 identificada pelo servidor.",
        "processing": "Restringe \u00e0s tarefas vis\u00edveis ao membro (membroVeResponsavelOuCriador). Pend\u00eancias: tarefas cujo quemAgeAgora calculado \u00e9 a pessoa da sess\u00e3o (quemAgeAgoraPorSituacao) \u2014 a fazer ou em andamento como respons\u00e1vel, em revis\u00e3o como quem criou \u2014 incluindo as em andamento devolvidas e ainda n\u00e3o retomadas (devolvidaPendente, retomarSoAposDevolucao), ordenadas por prazo e criadaEm, com nome da lista, nomes do respons\u00e1vel e de quem criou e progressoChecklist calculado pela contagem dos itens. Alertas: tarefas abertas de que a pessoa \u00e9 respons\u00e1vel que vencem hoje ou est\u00e3o atrasadas (tarefaAbertaVencimento), ordenadas por prazo. Indicadores: contagens no servidor de abertas, vencem hoje, atrasadas e devolvidas pendentes entre as tarefas de que a pessoa \u00e9 respons\u00e1vel (tarefaAbertaVencimento). Permiss\u00f5es: l\u00ea o participante da sess\u00e3o e calcula aceitaTarefasEfetivo e podeCriarTarefasEfetivo como a marca do gestor ou sim quando n\u00e3o configurado (participanteNaoConfiguradoAceitaECria). Campos derivados s\u00e3o calculados, nunca gravados.",
        "output": "Lista de pend\u00eancias com situa\u00e7\u00e3o, prazo, prioridade, lista, respons\u00e1vel, quem criou, progresso e motivo da devolu\u00e7\u00e3o; lista de alertas de prazo com t\u00edtulo e prazo; os quatro contadores j\u00e1 calculados; e o nome com as marcas efetivas da pessoa da sess\u00e3o."
      }
    },
    {
      "id": "iniciarTarefa",
      "kind": "cmd",
      "when": "iniciarTarefa",
      "writes": "Tarefa.iniciar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "tarefa",
          "type": "PendenciaTarefa",
          "origin": null
        },
        {
          "name": "indicadores",
          "type": "IndicadoresTarefas",
          "origin": null
        }
      ],
      "rules": [
        "apenasResponsavelExecuta",
        "quemAgeAgoraPorSituacao"
      ],
      "jsdoc": {
        "purpose": "Inicia uma tarefa a fazer de que a pessoa da sess\u00e3o \u00e9 respons\u00e1vel.",
        "input": "id: tarefa a iniciar; version: vers\u00e3o lida, para controle de concorr\u00eancia.",
        "processing": "Recusa se a pessoa da sess\u00e3o n\u00e3o for o respons\u00e1vel (apenasResponsavelExecuta), se a situa\u00e7\u00e3o n\u00e3o for aFazer ou se a vers\u00e3o divergir. Executa a transi\u00e7\u00e3o iniciar para emAndamento; o respons\u00e1vel continua sendo quem age agora (quemAgeAgoraPorSituacao, calculado). Recalcula os contadores da pessoa.",
        "output": "A tarefa na nova situa\u00e7\u00e3o em andamento, com lista, nomes, progresso e campos derivados recalculados, e os contadores atualizados da pessoa."
      }
    },
    {
      "id": "enviarRevisao",
      "kind": "cmd",
      "when": "enviarRevisao",
      "writes": "Tarefa.enviarParaRevisao",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "tarefa",
          "type": "PendenciaTarefa",
          "origin": null
        },
        {
          "name": "indicadores",
          "type": "IndicadoresTarefas",
          "origin": null
        }
      ],
      "rules": [
        "apenasResponsavelExecuta",
        "avisarQuemAgeAgora",
        "avisoNaoSobrepostoPorPessoa",
        "quemAgeAgoraPorSituacao"
      ],
      "jsdoc": {
        "purpose": "Envia para revis\u00e3o (ou reenvia ap\u00f3s devolu\u00e7\u00e3o) uma tarefa em andamento de que a pessoa da sess\u00e3o \u00e9 respons\u00e1vel.",
        "input": "id: tarefa a enviar; version: vers\u00e3o lida, para controle de concorr\u00eancia.",
        "processing": "Recusa se a pessoa da sess\u00e3o n\u00e3o for o respons\u00e1vel (apenasResponsavelExecuta), se a situa\u00e7\u00e3o n\u00e3o for emAndamento ou se a vers\u00e3o divergir. Executa a transi\u00e7\u00e3o enviarParaRevisao para emRevisao; quem criou passa a ser quem age agora (quemAgeAgoraPorSituacao) e \u00e9 avisado pelo processo da tarefa (avisarQuemAgeAgora), sem iniciar novo aviso para quem j\u00e1 tem um em andamento (avisoNaoSobrepostoPorPessoa). Recalcula os contadores.",
        "output": "A tarefa em revis\u00e3o, com quem age agora j\u00e1 sendo quem criou, e os contadores atualizados da pessoa."
      }
    },
    {
      "id": "aceitarTarefa",
      "kind": "cmd",
      "when": "aceitarTarefa",
      "writes": "Tarefa.aceitar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",

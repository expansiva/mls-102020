{
  "$id": "https://collab.codes/schemas/agentPlannerL2/menu/2026-09-19-p2-menu-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tree",
    "authorities",
    "meta"
  ],
  "properties": {
    "tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority" }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/hubNode" },
        { "$ref": "#/$defs/pageNode" },
        { "$ref": "#/$defs/groupNode" }
      ]
    },
    "hubNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "context",
        "text",
        "children"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["hub"] },
        "label": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "text": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "pageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "organisms"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["page"] },
        "label": { "type": "string", "minLength": 1 },
        "organisms": {
          "type": "array",
          "items": { "$ref": "#/$defs/organism" }
        }
      }
    },
    "groupNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "text",
        "children"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["group"] },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["list", "detail", "form", "summary", "highlights", "timeline", "actions"]
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorRef",
        "nodes"
      ],
      "properties": {
        "actorRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "nodes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journeys",
        "processes"
      ],
      "properties": {
        "journeys": {
          "type": "array",
          "items": { "$ref": "#/$defs/journeyPages" }
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "journeyPages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journeyId",
        "pages"
      ],
      "properties": {
        "journeyId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "pages": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
        }
      }
    }
  }
}

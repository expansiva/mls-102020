{
  "$id": "https://collab.codes/schemas/agentPlannerL2/contracts/2026-09-18-p2-contracts-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaces"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2026-09-18-p2-contracts-v1" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workspace" }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "calls"
      ],
      "properties": {
        "workspaceId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/call" }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callName",
        "kind",
        "stepRef",
        "entityRef",
        "shape",
        "transitionRef",
        "inputFields",
        "outputFields"
      ],
      "properties": {
        "callName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "kind": { "type": "string", "enum": ["query", "command"] },
        "stepRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "entityRef": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "shape": { "type": "string", "enum": ["list", "get", "create", "update", "transition", "ddm"] },
        "transitionRef": { "type": "string" },
        "inputFields": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$" }
        },
        "outputFields": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/ns4/e8-workspace-presentation-v3.json",
  "title": "NS4 E8 strict workspace presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "schemaVersion", "moduleName", "userLanguage", "reviewRound", "title", "workspaces", "menuSections", "changeSummary"],
  "properties": {
    "planId": {"const": "e8-skeleton-presentation"},
    "schemaVersion": {"const": "2026-08-14-ns4-e8-presentation-v3"},
    "moduleName": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
    "userLanguage": {"type": "string", "minLength": 2},
    "reviewRound": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceId", "title", "description", "pageContext", "scenarios"],
        "properties": {
          "workspaceId": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "pageContext": {"type": "array", "items": {"$ref": "#/$defs/context"}},
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scenarioId", "title", "description", "selectionContexts"],
              "properties": {
                "scenarioId": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
                "title": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "selectionContexts": {"type": "array", "items": {"$ref": "#/$defs/context"}},
                "surface": {"enum": ["queueAction", "contextualModal", "batchAction"]},
                "surfaceJustification": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "menuSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureRef", "label"],
        "properties": {
          "featureRef": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "changeSummary": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextId", "businessObject", "cardinality", "required", "idFieldRef"],
      "properties": {
        "contextId": {"type": "string", "minLength": 1},
        "businessObject": {"type": "string", "minLength": 1},
        "cardinality": {"enum": ["one", "many"]},
        "required": {"type": "boolean"},
        "idFieldRef": {"type": "string"}
      }
    }
  }
}

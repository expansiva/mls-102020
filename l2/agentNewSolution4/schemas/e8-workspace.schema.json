{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collab.codes/schemas/ns4/e8-workspace-v1.json",
  "title": "NS4 E8 workspace skeleton",
  "type": "object",
  "required": ["planId", "schemaVersion", "moduleName", "userLanguage", "reviewRound", "workspaces", "menu", "edges", "contextCatalog"],
  "properties": {
    "planId": {"const": "e8-skeleton-review"},
    "schemaVersion": {"const": "2026-08-11-ns4-e8-skeleton-v1"},
    "moduleName": {"pattern": "^[a-z][A-Za-z0-9]*$"},
    "userLanguage": {"type": "string", "minLength": 2},
    "reviewRound": {"type": "integer", "minimum": 1},
    "workspaces": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["workspaceId", "kind", "title", "description", "profileRefs", "hostedStepRefs", "useCaseIds", "commandEntityRefs", "pageContext", "slices", "scenarios"], "properties": {"workspaceId": {"pattern": "^[a-z][A-Za-z0-9]*$"}, "kind": {"enum": ["hub", "place"]}, "anchorEntity": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "profileRefs": {"type": "array"}, "hostedStepRefs": {"type": "array", "minItems": 1}, "useCaseIds": {"type": "array", "minItems": 1}, "commandEntityRefs": {"type": "array"}, "pageContext": {"type": "array"}, "slices": {"type": "array"}, "scenarios": {"type": "array", "minItems": 1}}}},
    "menu": {"type": "object", "required": ["headerLinks", "sections", "landings"]},
    "edges": {"type": "array"},
    "contextCatalog": {"type": "array"}
  }
}

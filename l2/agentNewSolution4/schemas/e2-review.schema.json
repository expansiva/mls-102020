{
  "$id": "https://collab.codes/schemas/agentNewSolution4/e2-review/2026-08-09-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["planId", "moduleName", "userLanguage", "title", "reviewRound", "journeys", "features"],
  "properties": {
    "planId": { "const": "e2-review" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "userLanguage": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "journeys": { "type": "array", "minItems": 1 },
    "features": { "type": "array" }
  }
}

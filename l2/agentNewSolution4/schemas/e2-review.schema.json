{
  "$id": "https://collab.codes/schemas/agentNewSolution4/e2-review/2026-08-14-v5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["planId", "moduleName", "userLanguage", "title", "reviewRound", "journeys", "features"],
  "properties": {
    "planId": { "const": "e2-review" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "userLanguage": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["journeyId", "business", "policyDecisions"],
        "properties": {
          "journeyId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "business": { "type": "object" },
          "policyDecisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["decisionId", "question", "chosen", "alternatives"],
              "properties": {
                "decisionId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "question": { "type": "string", "minLength": 1 },
                "chosen": { "type": "string", "minLength": 1 },
                "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            }
          }
        }
      }
    },
    "features": { "type": "array" }
  }
}

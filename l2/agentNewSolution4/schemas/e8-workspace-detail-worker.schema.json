{
  "$id": "https://collab.codes/schemas/agentNewSolution4/e8-workspace-detail-worker/2026-08-12-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "moduleName", "workspaceId", "skeletonHash", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2026-08-11-ns4-workspace-detail-v1" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "workspaceId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "skeletonHash": { "type": "string", "minLength": 1 },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "fieldRef": {
      "type": "object", "additionalProperties": false, "required": ["entityId", "fieldId"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^$|^[A-Z][A-Za-z0-9]*$" },
        "fieldId": { "type": "string", "pattern": "^$|^[a-z][A-Za-z0-9]*$" }
      }
    },
    "organism": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "fragmentRef", "sliceId", "fieldRefs", "intent", "usage"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "fragmentRef": { "type": "string", "minLength": 1 },
        "sliceId": { "type": "string", "pattern": "^$|^[a-z][A-Za-z0-9]*$" },
        "fieldRefs": { "type": "array", "items": { "$ref": "#/$defs/fieldRef" } },
        "intent": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "enum": ["", "picker"] }
      }
    },
    "commandInput": {
      "type": "object", "additionalProperties": false,
      "required": ["inputId", "fieldRef", "source", "sourceRef"],
      "properties": {
        "inputId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "fieldRef": { "$ref": "#/$defs/fieldRef" },
        "source": { "type": "string", "enum": ["pageContext", "selection", "userDecision", "actorSession"] },
        "sourceRef": { "type": "string" }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["useCaseId", "inputs"],
      "properties": {
        "useCaseId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/commandInput" } }
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioId", "organisms", "commandInputs"],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "organisms": { "type": "array", "items": { "$ref": "#/$defs/organism" } },
        "commandInputs": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    }
  }
}

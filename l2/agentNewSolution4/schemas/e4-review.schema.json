{
  "$id": "https://collab.codes/schemas/agentNewSolution4/e4-review/2026-08-05-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "moduleName", "userLanguage", "title", "reviewRound", "solutionMode", "businessDomain", "entities", "relationships", "changeSummary"],
  "properties": {
    "planId": { "type": "string", "const": "e4-ontology-review" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "userLanguage": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "solutionMode": { "type": "string", "const": "new" },
    "businessDomain": { "type": "string", "minLength": 1 },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "changeSummary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sourceRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyIds", "featureIds", "authorityRefs"],
      "properties": {
        "journeyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "featureIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authorityRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraintId", "kind", "value", "description", "source"],
      "properties": {
        "constraintId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "kind": { "type": "string", "enum": ["min", "max", "minLength", "maxLength", "pattern", "enum", "format", "unique", "custom"] },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["database", "journey", "user", "inferred", "legacyCode"] }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["fieldId", "title", "type", "required", "description", "constraints"],
      "properties": {
        "fieldId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["uuid", "string", "text", "number", "integer", "boolean", "money", "date", "datetime", "json"] },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["invariantId", "description", "source"],
      "properties": {
        "invariantId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["database", "journey", "user", "inferred", "legacyCode"] }
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "title", "description", "kind", "ownership", "sourceRefs", "fields", "lifecycleStates", "invariants", "storage"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["core", "event", "supporting", "mdm", "projection", "valueObject"] },
        "ownership": { "type": "string", "enum": ["moduleOwned", "external", "derived"] },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "lifecycleStates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "notes"],
          "properties": { "mode": { "type": "string", "const": "new" }, "notes": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationshipId", "fromEntity", "toEntity", "type", "required", "description"],
      "properties": {
        "relationshipId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "fromEntity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "toEntity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "type": { "type": "string", "enum": ["oneToOne", "oneToMany", "manyToOne", "manyToMany"] },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}

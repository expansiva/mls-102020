{
  "$id": "https://collab.codes/schemas/agentNewSolution4/module/2026-08-05-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "presentation", "module", "designContext", "specStatus"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2026-08-05-ns4-module-v2" },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userLanguage", "stepTitles"],
      "properties": {
        "userLanguage": { "type": "string", "minLength": 2 },
        "stepTitles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["e1-clarification", "e1-compile", "e2-journeys", "e3-ontology", "e4-rules", "e5-behaviors", "e6-realization", "e7-workspaces", "e8-navigation-compiler", "e9-validation"],
          "properties": {
            "e1-clarification": { "type": "string", "minLength": 1 },
            "e1-compile": { "type": "string", "minLength": 1 },
            "e2-journeys": { "type": "string", "minLength": 1 },
            "e3-ontology": { "type": "string", "minLength": 1 },
            "e4-rules": { "type": "string", "minLength": 1 },
            "e5-behaviors": { "type": "string", "minLength": 1 },
            "e6-realization": { "type": "string", "minLength": 1 },
            "e7-workspaces": { "type": "string", "minLength": 1 },
            "e8-navigation-compiler": { "type": "string", "minLength": 1 },
            "e9-validation": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleName", "title", "purpose", "languages"],
      "properties": {
        "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-(?:[A-Z]{2}|[A-Z][a-z]{3}|[A-Za-z0-9]{2,8}))*$" }
        }
      }
    },
    "designContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialPrompt", "clarification"],
      "properties": {
        "initialPrompt": { "type": "string", "minLength": 1 },
        "clarification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mainActors", "mainGoal", "boundaries"],
          "properties": {
            "mainActors": { "type": "string" },
            "mainGoal": { "type": "string", "minLength": 1 },
            "boundaries": { "type": "string" }
          }
        }
      }
    },
    "specStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "flowVersion", "state", "artifactCompleteness", "completedSteps", "nextStep", "updatedAt"],
      "properties": {
        "flowId": { "type": "string", "const": "agentNewSolution4" },
        "flowVersion": { "type": "string", "const": "2026-08-05-ns4-flow-v3" },
        "state": { "type": "string", "const": "inProgress" },
        "artifactCompleteness": { "type": "string", "const": "partial" },
        "completedSteps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepId", "status", "approvedBy", "approvedAt"],
            "properties": {
              "stepId": { "type": "string", "enum": ["e1", "e2-journeys"] },
              "status": { "type": "string", "const": "approved" },
              "approvedBy": { "type": "string", "enum": ["human", "auto"] },
              "approvedAt": { "type": "string", "minLength": 10 }
            }
          }
        },
        "nextStep": { "type": "string", "enum": ["e2-journeys", "e3-ontology"] },
        "updatedAt": { "type": "string", "minLength": 10 }
      }
    }
  }
}
